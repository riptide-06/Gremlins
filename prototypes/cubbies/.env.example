# Export these privately. This file is documentation, not auto-loaded dotenv.
PUBLIC_URL=https://YOUR-SERVICE
GOOGLE_CLOUD_PROJECT=YOUR-PROJECT
GOOGLE_CLIENT_ID=YOUR-WEB-OAUTH-CLIENT-ID
GOOGLE_CLIENT_SECRET=REPLACE-PRIVATELY
SESSION_SECRET=REPLACE-WITH-A-STRONG-RANDOM-SECRET
DRIVE_TOKEN_KEY=REPLACE-WITH-A-FERNET-KEY
ALLOWED_DOMAIN=ucsc.edu
CUBBY_SERVICE_ACCOUNT=drive-target@YOUR-PROJECT.iam.gserviceaccount.com
CUBBY_ADMINS=administrator@ucsc.edu
