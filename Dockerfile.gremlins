FROM python:3.12-slim
WORKDIR /app
COPY --from=ghcr.io/astral-sh/uv:0.7.4 /uv /usr/local/bin/uv
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev
COPY gremlin_app.py box.py brain.py dept_gremlin.py wall.py advocate.py cubby_store.py mcp_server.py site.html ./
COPY docs/boxes ./docs/boxes
# The service runs unprivileged. It writes only under out/ (a working copy of the boxes, the
# replay cache), never to the tracked boxes or the code.
RUN useradd --uid 10001 --create-home gremlin && mkdir -p /app/out && chown gremlin:gremlin /app/out
USER gremlin
ENV PYTHONUNBUFFERED=1
CMD ["sh", "-c", "exec /app/.venv/bin/uvicorn gremlin_app:app --host 0.0.0.0 --port ${PORT:-8080} --no-access-log"]
